// Cloudflare settings for janmat.net.
// The site's files are served as static assets. worker.js runs first only to
// redirect the old workers.dev address to janmat.net.
{
  "name": "democracy-dismantled",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
